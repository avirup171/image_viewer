{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Image Viewer",
  "version": "0.1.0",
  "identifier": "com.avirup171.image_viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Image Viewer",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "backgroundColor": "#16171A"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "shortDescription": "A fast, simple image viewer",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
